        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettelohaku toimii laitteellasi. Reaaliaikaiseen hakuun lähetetään vain pyöristetty sijainti Overpass-palveluihin (FOSSGIS tai Private.coffee)."
